# Copia este archivo como .env (NO se sube a GitHub) y ajusta los valores.

# Dominio público (registro A snackmary -> IP del VPS)
DOMINIO=snackmary.moqueguasoft.com

# Traefik: valores del VPS de Moqueguasoft (igual que factura-web)
TRAEFIK_NETWORK=traefik-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_CERTRESOLVER=letsencrypt

# Base de datos (contraseñas largas y únicas)
DB_NAME=snackmary
DB_USER=snackmary
DB_PASS=cambia_esta_clave
DB_ROOT_PASS=cambia_esta_clave_root

# Prefijo de los contenedores y rutas de Traefik (cambiarlo solo para una 2da instancia, ej: snackmary-demo)
PREFIJO=snackmary
# 1 = modo demo (ver README, sección "Instancia de demostración")
APP_DEMO=0
# WhatsApp de soporte que aparece en la sección Ayuda
SOPORTE_WHATSAPP=
