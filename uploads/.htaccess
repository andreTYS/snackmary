# Solo se sirven imágenes; nunca se ejecuta código en esta carpeta
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
Options -Indexes -ExecCGI
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?!(jpg|webp)$)[^.]+$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
</FilesMatch>
