# Instancia de demostración de Snack Mary.
# Copia como .env.demo y levántala con:
#   docker compose --env-file .env.demo -p snackmary-demo up -d --build
DOMINIO=snackmary-demo.moqueguasoft.com
PREFIJO=snackmary-demo
APP_DEMO=1
SOPORTE_WHATSAPP=

TRAEFIK_NETWORK=traefik-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_ENTRYPOINT_HTTP=web
TRAEFIK_CERTRESOLVER=letsencrypt

DB_NAME=snackmary_demo
DB_USER=snackmary_demo
DB_PASS=cambia_esta_clave
DB_ROOT_PASS=cambia_esta_clave_root
